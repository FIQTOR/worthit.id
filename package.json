{
  "name": "worthit-indonesia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@worthit/web run dev",
    "dev:web": "npm --workspace=@worthit/web run dev",
    "dev:api": "npm --workspace=@worthit/api run dev",
    "build": "npm --workspace=@worthit/shared run build && npm --workspace=@worthit/web run build",
    "build:all": "npm run build --workspaces",
    "test": "npm --workspace=@worthit/shared test",
    "typecheck": "npm --workspace=@worthit/shared run build && npm --workspace=@worthit/web run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
